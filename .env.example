# مسیر پایه برای GitHub Pages (برای دامنهٔ اختصاصی خالی بگذارید)
NEXT_PUBLIC_BASE_PATH=/enodigital
# آدرس کامل سایت برای canonical و sitemap
NEXT_PUBLIC_SITE_URL=https://amirhooseindamandarya.github.io/enodigital
# نقطهٔ اتصال API فرم‌ها (POST multipart/form-data). تا تنظیم نشود، فرم ارسال واقعی ندارد.
NEXT_PUBLIC_FORM_ENDPOINT=
# پنل مدیریت: مخزن و شاخه‌ای که تغییرات روی آن ذخیره می‌شود (در گردش‌کار انتشار خودکار تنظیم می‌شود)
NEXT_PUBLIC_ADMIN_REPO=amirhooseindamandarya/enodigital
NEXT_PUBLIC_ADMIN_BRANCH=main
