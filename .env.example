# ---------- سرور ----------
# آدرس عمومی سایت (برای بازگشت از درگاه پرداخت، canonical و sitemap)
APP_URL=https://enodigital.ir
# رمز پایگاه داده (docker-compose آن را می‌سازد)
DB_PASSWORD=change-me-to-a-long-random-password
# اگر بدون docker-compose اجرا می‌کنید (MySQL 8 یا MariaDB 10.5+؛ نویسه‌های خاص رمز را URL-encode کنید):
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/enodigital
# DATABASE_POOL=5

# ---------- مدیر کل (در اولین اجرا ساخته یا ارتقا داده می‌شود) ----------
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=مدیر سایت

# ---------- درگاه پرداخت زرین‌پال ----------
ZARINPAL_MERCHANT_ID=
# برای آزمایش با سندباکس زرین‌پال true کنید
ZARINPAL_SANDBOX=false
# فقط برای آزمایش بدون درگاه واقعی (هرگز در سرور اصلی true نکنید)
PAYMENT_MOCK=false

# ---------- پیامک (کاوه‌نگار) ----------
# بدون این تنظیمات پیامک‌ها فقط در لاگ سرور نوشته می‌شوند
SMS_DRIVER=
KAVENEGAR_API_KEY=
# نام قالب‌های verify در پنل کاوه‌نگار (token = کد / شمارهٔ سفارش / شمارهٔ تیکت)
KAVENEGAR_TEMPLATE_OTP=
KAVENEGAR_TEMPLATE_ORDER=
KAVENEGAR_TEMPLATE_TICKET=

# ---------- سایت ----------
# مسیر پایه (برای اجرا در زیرپوشه؛ روی دامنهٔ اختصاصی خالی بگذارید)
NEXT_PUBLIC_BASE_PATH=
# نقطهٔ ارسال فرم‌های تماس/دمو (POST JSON). خالی = فرم ارسال واقعی ندارد
NEXT_PUBLIC_FORM_ENDPOINT=
